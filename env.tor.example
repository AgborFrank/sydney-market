# Tor-specific environment configuration
# Copy this file to .env and modify as needed

# Database Configuration
DB_PATH=marketplace.db

# Tor Configuration
TOR_ENABLED=true
TOR_PROXY_PORT=5000
OFFLINE_MODE=false

# GPG Configuration for Tor
GPG_HOME=~/.gnupg_marketplace
GPG_BINARY=/usr/bin/gpg
GPG_TIMEOUT=30
GPG_FALLBACK_ENABLED=true

# Tor-specific timeouts
TOR_SESSION_TIMEOUT=3600
TOR_DB_TIMEOUT=30

# Session Configuration
SECRET_KEY=your-secret-key-here
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Redis Configuration (optional, will fallback to filesystem)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security Settings
DDOS_ENABLED=false
RATE_LIMIT_ENABLED=false
RECAPTCHA_ENABLED=false

# Cryptocurrency Settings
FALLBACK_BTC_PRICE=110000
FALLBACK_XMR_PRICE=150

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log 