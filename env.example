# Flask Configuration
SECRET_KEY=your-super-secret-key-here
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration
DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=secure_password_here
DB_HOST=localhost

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Tor Configuration
TOR_ENABLED=true
# Set to true when deploying over Tor network to enable proxy for external API calls
TOR_PROXY_PORT=5000
# Port for Tor SOCKS proxy (default: 9050 for Tor Browser, 5000 for custom setup)

# Offline Mode Configuration
OFFLINE_MODE=false
# Set to true when external APIs are unavailable (e.g., over Tor when APIs are blocked)
FALLBACK_BTC_PRICE=45000
FALLBACK_XMR_PRICE=150

# Cryptocurrency Configuration
ESCROW_PRIVATE_KEY=your-escrow-private-key
BLOCKCYPHER_TOKEN=your-blockcypher-token
WEBHOOK_URL=https://your-domain.com/webhook

# Monero Configuration
MONERO_RPC_HOST=localhost
MONERO_RPC_PORT=18081
MONERO_RPC_USER=
MONERO_RPC_PASSWORD=

# Security Configuration
DDOS_ENABLED=true
DDOS_MAX_REQUESTS_PER_MINUTE=6000
DDOS_MAX_REQUESTS_PER_HOUR=1000
DDOS_MAX_REQUESTS_PER_DAY=10000

# reCAPTCHA Configuration
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per day, 50 per hour
RATE_LIMIT_LOGIN=5 per minute
RATE_LIMIT_REGISTER=3 per hour

# Admin Configuration
ADMIN_BTC_ADDRESS=your-admin-btc-address

# GnuPG Configuration
GPG_HOME=/var/www/marketplace/.gnupg
GPG_BINARY=/usr/bin/gpg 

# Tor-specific CSRF settings
TOR_CSRF_DISABLED=false
TOR_CSRF_LENIENT=true 